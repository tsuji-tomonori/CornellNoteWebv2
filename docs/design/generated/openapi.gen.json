{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Login": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "pattern": "^(alice|bob)$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "Note": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "default": "",
            "maxLength": 80000,
            "title": "Content",
            "type": "string"
          },
          "cue": {
            "default": "",
            "maxLength": 20000,
            "title": "Cue",
            "type": "string"
          },
          "group": {
            "default": "未分類",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Group",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "summary": {
            "default": "",
            "maxLength": 20000,
            "title": "Summary",
            "type": "string"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "maxItems": 100,
            "title": "Tasks",
            "type": "array"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "title",
          "id",
          "version",
          "updated_at"
        ],
        "title": "Note",
        "type": "object"
      },
      "NoteInput": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "default": "",
            "maxLength": 80000,
            "title": "Content",
            "type": "string"
          },
          "cue": {
            "default": "",
            "maxLength": 20000,
            "title": "Cue",
            "type": "string"
          },
          "group": {
            "default": "未分類",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Group",
            "type": "string"
          },
          "summary": {
            "default": "",
            "maxLength": 20000,
            "title": "Summary",
            "type": "string"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "maxItems": 100,
            "title": "Tasks",
            "type": "array"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "NoteInput",
        "type": "object"
      },
      "NoteUpdate": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "default": "",
            "maxLength": 80000,
            "title": "Content",
            "type": "string"
          },
          "cue": {
            "default": "",
            "maxLength": 20000,
            "title": "Cue",
            "type": "string"
          },
          "group": {
            "default": "未分類",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Group",
            "type": "string"
          },
          "summary": {
            "default": "",
            "maxLength": 20000,
            "title": "Summary",
            "type": "string"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "maxItems": 100,
            "title": "Tasks",
            "type": "array"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Title",
            "type": "string"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "title",
          "version"
        ],
        "title": "NoteUpdate",
        "type": "object"
      },
      "Share": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "expires_at"
        ],
        "title": "Share",
        "type": "object"
      },
      "Task": {
        "properties": {
          "done": {
            "default": false,
            "title": "Done",
            "type": "boolean"
          },
          "due": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "text": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "title": "Task",
        "type": "object"
      },
      "Token": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "Token",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Cornell Note API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/local": {
      "post": {
        "operationId": "local_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
