  pure val allowedPillars = Set("requirements", "design", "checks", "auxiliary")
  pure val guardrailPillars = Set("requirements", "design", "checks")
  pure val allowedApplicability = Set(
    "when-explicitly-requested",
    "when-concrete-duty-exists",
    "when-external-authority-boundary-exists",
    "when-ambiguity-changes-result",
    "when-development-is-requested",
    "when-frontend-design-is-needed",
    "when-frontend-requirements-are-needed",
    "when-a-declared-generator-supports-the-change",
    "when-frontend-implementation-is-requested",
    "when-change-relevant-checks-exist",
    "when-user-or-target-selects-style",
    "when-durable-obligation-changes-or-authority-is-initialized",
    "when-reference-assets-change",
    "when-evidenced-systemic-trigger-exists",
    "when-execution-sizing-is-needed",
    "when-frontend-testing-is-requested",
    "when-a-relevant-standard-is-selected"
  )
  pure val allowedActivationContexts = Set(
    "explicit-review-request",
    "concrete-regulated-duty",
    "external-authority-boundary",
    "material-ambiguity",
    "development-request",
    "frontend-requirements",
    "frontend-design",
    "frontend-implementation",
    "frontend-testing",
    "supported-as-built-surface",
    "selected-checks",
    "target-commit-style",
    "durable-requirement-change",
    "reference-maintenance",
    "evidenced-systemic-failure",
    "execution-sizing",
    "relevant-standard"
  )
  pure val allowedAuthorities = Set(
    "artifact-authority",
    "concrete-duty-or-user",
    "explicit-user-authorization",
    "user-intent",
    "user-and-target-repository",
    "approved-requirements",
    "implementation",
    "requirements-and-design",
    "target-repository-and-selected-checks",
    "explicit-user-or-target-repository-style",
    "quint-requirements",
    "reference-repository",
    "observed-defect",
    "change-risk",
    "frontend-requirements-and-approved-design",
    "canonical-requirements-target-policy-and-selected-official-standards"
  )
  pure val allowedSideEffects = Set(
    "none",
    "repository-write",
    "repository-and-authorized-external-write",
    "repository-confined-temporary-write",
    "target-command-effects"
  )
  pure val allowedFailureStates = Set(
    "report-bounded",
    "no-op-unless-triggered",
    "no-op-unless-selected",
    "return-for-clarification",
    "return-to-requirements",
    "return-to-design",
    "stop-at-authority-boundary",
    "fail-on-drift",
    "fail-on-invalid-catalog"
  )
  pure val allowedPolicySubjects = Set(
    "ci-workflow",
    "required-check",
    "branch-protection",
    "ruleset",
    "merge-strategy",
    "pr-template",
    "commit-format"
  )
  pure val allowedPillarStatuses = Set("pending", "complete", "skipped-not-applicable")
  pure val allowedPhases = Set("intake", "design", "checks", "done")
  pure val allowedPolicyDecisions = Set("not-requested", "pending", "rejected-host-owned")
  pure val defaultSkills = Set(
    "chat-first-development",
    "maintain-canonical-requirements",
    "generate-implementation-design",
    "inspect-quality-gates"
  )

  pure def pairwiseUnique(contracts: List[SkillContract]): bool =
    contracts.indices().forall(i =>
      contracts.indices().forall(j => i == j or contracts.nth(i).name != contracts.nth(j).name)
    )

  pure def pairwiseUniqueStrings(values: List[str]): bool =
    values.indices().forall(i =>
      values.indices().forall(j => i == j or values.nth(i) != values.nth(j))
    )

  pure def policyPreservesHostOwnership(policy: RepositoryPolicy): bool = all {
    not(policy.ciWorkflow),
    not(policy.requiredCheck),
    not(policy.branchProtection),
    not(policy.ruleset),
    not(policy.mergeStrategy),
    not(policy.prTemplate),
    not(policy.commitFormat),
  }

  pure def contractsAreComplete(contracts: List[SkillContract]): bool = all {
    contracts.length() == 18,
    pairwiseUnique(contracts),
    contracts.indices().forall(i => all {
      contracts.nth(i).name != "",
      contracts.nth(i).precondition != "",
      contracts.nth(i).postcondition != "",
      contracts.nth(i).inputs.length() > 0,
      contracts.nth(i).outputs.length() > 0,
      contracts.nth(i).obligationIds.length() > 0,
      contracts.nth(i).prohibitions.length() > 0,
      contracts.nth(i).activationContexts.length() > 0,
      pairwiseUniqueStrings(contracts.nth(i).activationContexts),
      pairwiseUniqueStrings(contracts.nth(i).inputs),
      pairwiseUniqueStrings(contracts.nth(i).outputs),
      pairwiseUniqueStrings(contracts.nth(i).obligationIds),
      pairwiseUniqueStrings(contracts.nth(i).prohibitions),
      pairwiseUniqueStrings(contracts.nth(i).requiredAssets),
      pairwiseUniqueStrings(contracts.nth(i).dependencies),
      pairwiseUniqueStrings(contracts.nth(i).requirementIds),
      contracts.nth(i).activationContexts.indices().forall(j =>
        allowedActivationContexts.contains(contracts.nth(i).activationContexts.nth(j))
      ),
      allowedApplicability.contains(contracts.nth(i).applicability),
      allowedAuthorities.contains(contracts.nth(i).authority),
      allowedSideEffects.contains(contracts.nth(i).sideEffect),
      allowedFailureStates.contains(contracts.nth(i).failureState),
      // Quint 0.32 treats strings as opaque values.  The extraction boundary
      // validates these three fields as exactly 64 lowercase hex characters.
      contracts.nth(i).manualBodySha256 != "",
      contracts.nth(i).payloadSha256 != "",
      contracts.nth(i).interfaceSha256 != "",
      allowedPillars.contains(contracts.nth(i).pillar),
    }),
  }

  pure def dependenciesAreClosed(contracts: List[SkillContract]): bool =
    contracts.indices().forall(i =>
      contracts.nth(i).dependencies.indices().forall(j =>
        contracts.indices().exists(k => all {
          contracts.nth(k).name == contracts.nth(i).dependencies.nth(j),
          // Every edge follows this catalog's topological order.  A strict
          // increase rules out self edges and dependency cycles.
          k > i,
        })
      )
    )

  pure def threePillarsOnly(contracts: List[SkillContract]): bool = all {
    contracts.indices().forall(i => all {
      contracts.nth(i).guardrail.implies(guardrailPillars.contains(contracts.nth(i).pillar)),
      contracts.nth(i).repositoryBlocking.iff(contracts.nth(i).guardrail),
      (contracts.nth(i).pillar == "auxiliary").implies(not(contracts.nth(i).repositoryBlocking)),
    }),
    guardrailPillars.forall(pillar =>
      contracts.indices().filter(i => all {
        contracts.nth(i).guardrail,
        contracts.nth(i).pillar == pillar,
      }).size() == 1
    ),
    contracts.indices().filter(i => contracts.nth(i).repositoryBlocking).size() == 3,
  }

  pure def repositoryPolicyIsHostOwned(contracts: List[SkillContract]): bool =
    contracts.indices().forall(i => policyPreservesHostOwnership(contracts.nth(i).repositoryPolicy))

  pure def runnerConformanceIsExplicit(contracts: List[SkillContract]): bool = all {
    contracts.indices().forall(i =>
      contracts.nth(i).externalEffect.iff(
        contracts.nth(i).sideEffect == "repository-and-authorized-external-write" or
        contracts.nth(i).sideEffect == "target-command-effects"
      )
    ),
    contracts.indices().filter(i => contracts.nth(i).externalEffect).size() == 3,
    contracts.indices().filter(i => contracts.nth(i).sideEffect == "target-command-effects").forall(i =>
      contracts.nth(i).externalEffect
    ),
  }

  pure def defaultPortableSetIsMinimal(contracts: List[SkillContract]): bool = all {
    contracts.indices().filter(i => contracts.nth(i).defaultPortable).size() == 4,
    contracts.indices().forall(i =>
      contracts.nth(i).defaultPortable.iff(defaultSkills.contains(contracts.nth(i).name))
    ),
  }

  var contracts: List[SkillContract]
  var phase: str
  var requirementsApplicable: bool
  var designApplicable: bool
  var checksApplicable: bool
  var requirementsStatus: str
  var designStatus: str
  var checksStatus: str
  var policyRequest: str
  var policyDecision: str
  var policyMutationApplied: bool

  action initCase(requirementsApply: bool, designApply: bool, checksApply: bool): bool = all {
    contracts' = skillContracts,
    phase' = "intake",
    requirementsApplicable' = requirementsApply,
    designApplicable' = designApply,
    checksApplicable' = checksApply,
    requirementsStatus' = "pending",
    designStatus' = "pending",
    checksStatus' = "pending",
    policyRequest' = "none",
    policyDecision' = "not-requested",
    policyMutationApplied' = false,
  }

  action init = any {
    initCase(false, false, false),
    initCase(false, false, true),
    initCase(false, true, false),
    initCase(false, true, true),
    initCase(true, false, false),
    initCase(true, false, true),
    initCase(true, true, false),
    initCase(true, true, true),
  }

  action settleRequirements = all {
    phase == "intake",
    contracts' = contracts,
    phase' = "design",
    requirementsApplicable' = requirementsApplicable,
    designApplicable' = designApplicable,
    checksApplicable' = checksApplicable,
    requirementsStatus' = if (requirementsApplicable) "complete" else "skipped-not-applicable",
    designStatus' = designStatus,
    checksStatus' = checksStatus,
    policyRequest' = policyRequest,
    policyDecision' = policyDecision,
    policyMutationApplied' = policyMutationApplied,
  }

  action settleDesign = all {
    phase == "design",
    requirementsStatus != "pending",
    contracts' = contracts,
    phase' = "checks",
    requirementsApplicable' = requirementsApplicable,
    designApplicable' = designApplicable,
    checksApplicable' = checksApplicable,
    requirementsStatus' = requirementsStatus,
    designStatus' = if (designApplicable) "complete" else "skipped-not-applicable",
    checksStatus' = checksStatus,
    policyRequest' = policyRequest,
    policyDecision' = policyDecision,
    policyMutationApplied' = policyMutationApplied,
  }

  action runSelectedChecks = all {
    phase == "checks",
    requirementsStatus != "pending",
    designStatus != "pending",
    policyDecision != "pending",
    contracts' = contracts,
    phase' = "done",
    requirementsApplicable' = requirementsApplicable,
    designApplicable' = designApplicable,
    checksApplicable' = checksApplicable,
    requirementsStatus' = requirementsStatus,
    designStatus' = designStatus,
    checksStatus' = if (checksApplicable) "complete" else "skipped-not-applicable",
    policyRequest' = policyRequest,
    policyDecision' = policyDecision,
    policyMutationApplied' = policyMutationApplied,
  }

  action requestPolicyMutation(subject: str): bool = all {
    phase != "done",
    policyRequest == "none",
    allowedPolicySubjects.contains(subject),
    contracts' = contracts,
    phase' = phase,
    requirementsApplicable' = requirementsApplicable,
    designApplicable' = designApplicable,
    checksApplicable' = checksApplicable,
    requirementsStatus' = requirementsStatus,
    designStatus' = designStatus,
    checksStatus' = checksStatus,
    policyRequest' = subject,
    policyDecision' = "pending",
    policyMutationApplied' = false,
  }

  action rejectPolicyMutation = all {
    policyRequest != "none",
    policyDecision == "pending",
    contracts' = contracts,
    phase' = phase,
    requirementsApplicable' = requirementsApplicable,
    designApplicable' = designApplicable,
    checksApplicable' = checksApplicable,
    requirementsStatus' = requirementsStatus,
    designStatus' = designStatus,
    checksStatus' = checksStatus,
    policyRequest' = policyRequest,
    policyDecision' = "rejected-host-owned",
    policyMutationApplied' = false,
  }

  action step = any {
    settleRequirements,
    settleDesign,
    runSelectedChecks,
    requestPolicyMutation("ci-workflow"),
    requestPolicyMutation("required-check"),
    requestPolicyMutation("branch-protection"),
    requestPolicyMutation("ruleset"),
    requestPolicyMutation("merge-strategy"),
    requestPolicyMutation("pr-template"),
    requestPolicyMutation("commit-format"),
    rejectPolicyMutation,
  }

  val formalContractsHold = all {
    contractsAreComplete(contracts),
    dependenciesAreClosed(contracts),
    threePillarsOnly(contracts),
    repositoryPolicyIsHostOwned(contracts),
    runnerConformanceIsExplicit(contracts),
    defaultPortableSetIsMinimal(contracts),
  }

  val workflowOrderIsConsistent = all {
    allowedPhases.contains(phase),
    allowedPillarStatuses.contains(requirementsStatus),
    allowedPillarStatuses.contains(designStatus),
    allowedPillarStatuses.contains(checksStatus),
    (requirementsStatus == "complete").implies(requirementsApplicable),
    (requirementsStatus == "skipped-not-applicable").implies(not(requirementsApplicable)),
    (designStatus == "complete").implies(designApplicable),
    (designStatus == "skipped-not-applicable").implies(not(designApplicable)),
    (checksStatus == "complete").implies(checksApplicable),
    (checksStatus == "skipped-not-applicable").implies(not(checksApplicable)),
    (phase == "design").implies(requirementsStatus != "pending"),
    (phase == "checks").implies(requirementsStatus != "pending" and designStatus != "pending"),
    (phase == "done").implies(all {
      requirementsStatus != "pending",
      designStatus != "pending",
      checksStatus != "pending",
      policyDecision != "pending",
    }),
  }

  val portablePolicyIsUntouched = all {
    not(policyMutationApplied),
    (policyRequest == "none" or allowedPolicySubjects.contains(policyRequest)),
    allowedPolicyDecisions.contains(policyDecision),
    (policyRequest == "none").iff(policyDecision == "not-requested"),
    (policyRequest != "none").implies(policyDecision == "pending" or policyDecision == "rejected-host-owned"),
  }
  val allInvariants = formalContractsHold and workflowOrderIsConsistent and portablePolicyIsUntouched

  run formalContractTest = {
    initCase(true, true, true).then(all {
      assert(formalContractsHold),
      contracts' = contracts,
      phase' = phase,
      requirementsApplicable' = requirementsApplicable,
      designApplicable' = designApplicable,
      checksApplicable' = checksApplicable,
      requirementsStatus' = requirementsStatus,
      designStatus' = designStatus,
      checksStatus' = checksStatus,
      policyRequest' = policyRequest,
      policyDecision' = policyDecision,
      policyMutationApplied' = policyMutationApplied,
    })
  }

  run orderedWorkflowTest = {
    initCase(true, true, true)
      .then(settleRequirements)
      .then(settleDesign)
      .then(runSelectedChecks)
      .then(all {
        assert(allInvariants),
        assert(requirementsStatus == "complete"),
        assert(designStatus == "complete"),
        assert(checksStatus == "complete"),
        contracts' = contracts,
        phase' = phase,
        requirementsApplicable' = requirementsApplicable,
        designApplicable' = designApplicable,
        checksApplicable' = checksApplicable,
        requirementsStatus' = requirementsStatus,
        designStatus' = designStatus,
        checksStatus' = checksStatus,
        policyRequest' = policyRequest,
        policyDecision' = policyDecision,
        policyMutationApplied' = policyMutationApplied,
      })
  }

  run nonApplicablePillarsSkipTest = {
    initCase(false, false, false)
      .then(settleRequirements)
      .then(settleDesign)
      .then(runSelectedChecks)
      .then(all {
        assert(allInvariants),
        assert(requirementsStatus == "skipped-not-applicable"),
        assert(designStatus == "skipped-not-applicable"),
        assert(checksStatus == "skipped-not-applicable"),
        contracts' = contracts,
        phase' = phase,
        requirementsApplicable' = requirementsApplicable,
        designApplicable' = designApplicable,
        checksApplicable' = checksApplicable,
        requirementsStatus' = requirementsStatus,
        designStatus' = designStatus,
        checksStatus' = checksStatus,
        policyRequest' = policyRequest,
        policyDecision' = policyDecision,
        policyMutationApplied' = policyMutationApplied,
      })
  }

  run policyMutationRejectedTest = {
    initCase(false, false, false)
      .then(requestPolicyMutation("ci-workflow"))
      .then(rejectPolicyMutation)
      .then(settleRequirements)
      .then(settleDesign)
      .then(runSelectedChecks)
      .then(all {
        assert(allInvariants),
        assert(policyRequest == "ci-workflow"),
        assert(policyDecision == "rejected-host-owned"),
        contracts' = contracts,
        phase' = phase,
        requirementsApplicable' = requirementsApplicable,
        designApplicable' = designApplicable,
        checksApplicable' = checksApplicable,
        requirementsStatus' = requirementsStatus,
        designStatus' = designStatus,
        checksStatus' = checksStatus,
        policyRequest' = policyRequest,
        policyDecision' = policyDecision,
        policyMutationApplied' = policyMutationApplied,
      })
  }
}
